<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title><%= inquiry.fullName %> · Lead #<%= inquiry.id %> | <%= siteConfig.name %></title>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Geist', sans-serif; }
    .ms { font-family: 'Material Symbols Outlined'; font-weight: normal; font-style: normal; font-size: 20px; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr; -webkit-font-smoothing: antialiased; }

    :root {
      --border: #e2e2e2;
      --bg: #ffffff;
      --bg-subtle: #f7f7f7;
      --bg-muted: #f0f0f0;
      --text: #111111;
      --text-muted: #666666;
      --text-faint: #999999;
    }

    body { background: var(--bg-subtle); color: var(--text); margin: 0; }

    .sidebar { width: 240px; min-height: 100vh; border-right: 1px solid var(--border); background: var(--bg); position: fixed; left: 0; top: 0; z-index: 40; display: flex; flex-direction: column; }
    .sidebar-logo { padding: 24px 20px; border-bottom: 1px solid var(--border); }
    .sidebar-nav { flex: 1; padding: 12px 12px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 6px; font-size: 14px; font-weight: 500; color: var(--text-muted); text-decoration: none; transition: all 0.15s ease; cursor: pointer; border: none; background: none; width: 100%; text-align: left; }
    .nav-item:hover { background: var(--bg-subtle); color: var(--text); }
    .nav-item .ms { font-size: 18px; }
    .nav-section { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); padding: 16px 12px 6px; }
    .sidebar-footer { padding: 16px 12px; border-top: 1px solid var(--border); }

    .main-content { margin-left: 240px; min-height: 100vh; }
    .topbar { height: 56px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 32px; background: var(--bg); position: sticky; top: 0; z-index: 30; }

    .card { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; }
    .card-header { padding: 20px 24px; border-bottom: 1px solid var(--border); }
    .card-body { padding: 24px; }

    .label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); display: block; margin-bottom: 5px; }
    .value { font-size: 14px; color: var(--text); }
    .value a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
    .value a:hover { color: var(--text-muted); }

    .info-row { display: flex; flex-direction: column; gap: 3px; padding: 14px 0; border-bottom: 1px solid var(--border); }
    .info-row:last-child { border-bottom: none; }

    .btn-primary { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 9px 18px; background: var(--text); color: #fff; border: 1px solid var(--text); border-radius: 5px; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
    .btn-primary:hover { opacity: 0.85; }
    .btn-ghost { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 8px 16px; background: transparent; color: var(--text-muted); border: 1px solid var(--border); border-radius: 5px; cursor: pointer; text-decoration: none; transition: all 0.12s; }
    .btn-ghost:hover { color: var(--text); border-color: var(--text); background: var(--bg-subtle); }
    .btn-danger { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 8px 16px; background: transparent; color: #c00; border: 1px solid #fcc; border-radius: 5px; cursor: pointer; text-decoration: none; transition: all 0.12s; }
    .btn-danger:hover { background: #fff0f0; border-color: #c00; }

    .status-select { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 7px 12px; border: 1px solid var(--border); background: var(--bg); color: var(--text); cursor: pointer; border-radius: 5px; outline: none; }
    .status-select:focus { border-color: var(--text); }

    .notes-area { width: 100%; padding: 14px; border: 1px solid var(--border); border-radius: 6px; font-size: 13.5px; color: var(--text); background: var(--bg); resize: vertical; min-height: 120px; outline: none; line-height: 1.6; box-sizing: border-box; font-family: 'Geist', sans-serif; }
    .notes-area:focus { border-color: var(--text); }

    .avatar-lg { width: 52px; height: 52px; background: var(--text); color: #fff; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; flex-shrink: 0; }

    .badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 10px; border: 1px solid; border-radius: 4px; }
    .badge-NEW { background: #f5f5f5; color: #333; border-color: #d4d4d4; }
    .badge-CONTACTED { background: #fafafa; color: #555; border-color: #ddd; }
    .badge-IN-DISCUSSION { background: #f0f0f0; color: #444; border-color: #ccc; }
    .badge-IN-PROGRESS { background: #1a1a1a; color: #fff; border-color: #111; }
    .badge-COMPLETED { background: #111; color: #fff; border-color: #000; }
    .badge-REJECTED { background: #fff0f0; color: #c00; border-color: #fcc; }

    .toast { position: fixed; bottom: 24px; right: 24px; background: var(--text); color: #fff; font-size: 13px; padding: 12px 18px; border-radius: 6px; transform: translateY(100px); opacity: 0; transition: all 0.2s ease; z-index: 99; display: flex; align-items: center; gap: 8px; }
    .toast.show { transform: translateY(0); opacity: 1; }

    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.2s ease; }
      .sidebar.open { transform: translateX(0); }
      .main-content { margin-left: 0; }
      .detail-grid { grid-template-columns: 1fr !important; }
    }
  </style>
</head>
<body>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="ms" style="font-size:20px;font-variation-settings:'FILL' 1;">terminal</span>
      <div>
        <div style="font-size:14px;font-weight:700;letter-spacing:-0.02em;line-height:1.2;"><%= siteConfig.name %></div>
        <div style="font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);margin-top:1px;">Admin Panel</div>
      </div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section">Workspace</div>
    <a href="/admin" class="nav-item">
      <span class="ms">grid_view</span> Dashboard
    </a>
    <a href="/admin?filter=New" class="nav-item">
      <span class="ms">fiber_new</span> New Leads
    </a>
    <a href="/admin?filter=In Progress" class="nav-item">
      <span class="ms">pending</span> In Progress
    </a>
    <a href="/admin?filter=Completed" class="nav-item">
      <span class="ms">check_circle</span> Completed
    </a>
    <div class="nav-section" style="margin-top:8px;">Actions</div>
    <a href="/admin/export" class="nav-item">
      <span class="ms">download</span> Export JSON
    </a>
    <a href="/" target="_blank" class="nav-item">
      <span class="ms">open_in_new</span> View Site
    </a>
  </nav>
  <div class="sidebar-footer">
    <a href="/admin/logout" class="nav-item" style="color:#c00;">
      <span class="ms">logout</span> Sign Out
    </a>
  </div>
</aside>

<!-- Main -->
<div class="main-content">
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:8px;">
      <a href="/admin" class="btn-ghost" style="padding:6px 10px;">
        <span class="ms" style="font-size:17px;">arrow_back</span>
      </a>
      <span style="font-size:13px;color:var(--text-muted);">Dashboard</span>
      <span style="font-size:13px;color:var(--text-faint);">/</span>
      <span style="font-size:13px;font-weight:600;color:var(--text);">Lead #<%= inquiry.id %></span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <button onclick="deleteInquiry(<%= inquiry.id %>)" class="btn-danger" style="padding:6px 12px;font-size:12px;">
        <span class="ms" style="font-size:15px;">delete</span> Delete
      </button>
    </div>
  </header>

  <div style="padding:32px;max-width:960px;">

    <!-- Lead Hero -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-body">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;">
          <div style="display:flex;align-items:center;gap:16px;">
            <div class="avatar-lg"><%= inquiry.fullName.charAt(0).toUpperCase() %></div>
            <div>
              <div style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:4px;">Lead #<%= inquiry.id %></div>
              <h1 style="font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--text);line-height:1.2;margin:0 0 6px;"><%= inquiry.fullName %></h1>
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                <% if (inquiry.company) { %><span style="font-size:13px;color:var(--text-muted);"><%= inquiry.company %></span><% } %>
                <a href="mailto:<%= inquiry.email %>" style="font-size:13px;color:var(--text-muted);text-decoration:underline;text-underline-offset:3px;"><%= inquiry.email %></a>
                <% if (inquiry.whatsapp) { %>
                  <a href="https://wa.me/<%= inquiry.whatsapp.replace(/[^\d+]/g, '') %>" target="_blank" style="font-size:13px;color:var(--text-muted);text-decoration:underline;text-underline-offset:3px;"><%= inquiry.whatsapp %></a>
                <% } %>
              </div>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:10px;">
            <div>
              <div style="font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);margin-bottom:6px;">Status</div>
              <div style="display:flex;align-items:center;gap:8px;">
                <select id="status-select" onchange="updateStatus(<%= inquiry.id %>, this.value)" class="status-select">
                  <% ['NEW', 'CONTACTED', 'IN DISCUSSION', 'IN PROGRESS', 'COMPLETED', 'REJECTED'].forEach(status => { %>
                    <option value="<%= status %>" <%= inquiry.status === status ? 'selected' : '' %>><%= status %></option>
                  <% }) %>
                </select>
                <span id="status-indicator" class="ms" style="font-size:18px;color:var(--text-faint);display:none;">check_circle</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Action Bar -->
        <div style="display:flex;gap:8px;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);flex-wrap:wrap;">
          <%
            const emailSubject = encodeURIComponent(`Project Inquiry — ${siteConfig.name}`);
            const emailBody = encodeURIComponent(`Hi ${inquiry.fullName},\n\nThanks for reaching out about your ${inquiry.projectType} project!\n\nI have reviewed your request and would love to connect to discuss further.\n\nBest regards,\n${siteConfig.name}`);
          %>
          <a href="mailto:<%= inquiry.email %>?subject=<%= emailSubject %>&body=<%= emailBody %>" class="btn-primary" style="font-size:12px;padding:8px 14px;">
            <span class="ms" style="font-size:16px;">mail</span> Email Client
          </a>
          <% if (inquiry.whatsapp) { %>
            <%
              const waText = encodeURIComponent(`Hi ${inquiry.fullName}, this is ${siteConfig.name}. I received your project request for a ${inquiry.projectType} and would love to connect.`);
              const waHref = `https://wa.me/${inquiry.whatsapp.replace(/[^\d+]/g, '')}?text=${waText}`;
            %>
            <a href="<%= waHref %>" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:7px 14px;">
              <span class="ms" style="font-size:16px;">chat</span> WhatsApp
            </a>
          <% } %>
          <% if (inquiry.website) { %>
            <a href="<%= inquiry.website %>" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:12px;padding:7px 14px;">
              <span class="ms" style="font-size:16px;">language</span> View Website
            </a>
          <% } %>
          <% const trackerUrl = `https://dev-harshil.vercel.app/track/${inquiry.trackingToken}`; %>
          <button onclick="copyTrackerLink('<%= trackerUrl %>')" class="btn-ghost" style="font-size:12px;padding:7px 14px;background:#111;color:#fff;border-color:#111;" title="Copy Client Live Tracker Link">
            <span class="ms" style="font-size:16px;">link</span> Copy Client Tracker Link
          </button>
          <a href="/track/<%= inquiry.trackingToken %>" target="_blank" class="btn-ghost" style="font-size:12px;padding:7px 14px;" title="Preview Live Tracker">
            <span class="ms" style="font-size:16px;">open_in_new</span> Preview Tracker
          </a>
        </div>
      </div>
    </div>

    <!-- Details + Notes Grid -->
    <div class="detail-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

      <!-- Client Info -->
      <div class="card">
        <div class="card-header">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);">Client Details</span>
        </div>
        <div class="card-body" style="padding:0 24px;">
          <div class="info-row">
            <span class="label">Full Name</span>
            <span class="value" style="font-weight:600;"><%= inquiry.fullName %></span>
          </div>
          <div class="info-row">
            <span class="label">Email</span>
            <span class="value"><a href="mailto:<%= inquiry.email %>"><%= inquiry.email %></a></span>
          </div>
          <div class="info-row">
            <span class="label">WhatsApp</span>
            <span class="value">
              <% if (inquiry.whatsapp) { %>
                <a href="https://wa.me/<%= inquiry.whatsapp.replace(/[^\d+]/g, '') %>" target="_blank"><%= inquiry.whatsapp %></a>
              <% } else { %>—<% } %>
            </span>
          </div>
          <div class="info-row">
            <span class="label">Company</span>
            <span class="value"><%= inquiry.company || '—' %></span>
          </div>
          <div class="info-row">
            <span class="label">Submitted On</span>
            <span class="value"><%= new Date(inquiry.createdAt).toLocaleDateString(undefined, {weekday:'short',month:'long',day:'numeric',year:'numeric'}) %></span>
          </div>
        </div>
      </div>

      <!-- Project Info -->
      <div class="card">
        <div class="card-header">
          <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);">Project Details</span>
        </div>
        <div class="card-body" style="padding:0 24px;">
          <div class="info-row">
            <span class="label">Project Type</span>
            <span class="value" style="font-weight:600;"><%= inquiry.projectType %></span>
          </div>
          <div class="info-row">
            <span class="label">Budget Range</span>
            <span class="value"><%= inquiry.budget %></span>
          </div>
          <div class="info-row">
            <span class="label">Timeline</span>
            <span class="value"><%= inquiry.timeline %></span>
          </div>
          <div class="info-row">
            <span class="label">Current Website</span>
            <span class="value">
              <% if (inquiry.website) { %>
                <a href="<%= inquiry.website %>" target="_blank" rel="noopener noreferrer"><%= inquiry.website %></a>
              <% } else { %>—<% } %>
            </span>
          </div>
          <div class="info-row">
            <span class="label">Last Updated</span>
            <span class="value"><%= new Date(inquiry.updatedAt).toLocaleDateString(undefined, {weekday:'short',month:'long',day:'numeric',year:'numeric'}) %></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Description -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header">
        <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);">Project Description</span>
      </div>
      <div class="card-body">
        <p style="font-size:14px;color:var(--text);line-height:1.75;white-space:pre-wrap;margin:0;"><%= inquiry.description %></p>
      </div>
    </div>

    <!-- Client Live Progress Tracker & Milestones Manager -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
        <div>
          <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);display:block;">Client Progress Tracker & Milestones</span>
          <span style="font-size:12px;color:var(--text-muted);">Updates reflect live on client tracking page</span>
        </div>
        <span id="milestone-indicator" class="ms" style="font-size:18px;color:var(--text-faint);display:none;">check_circle</span>
      </div>
      <div class="card-body">
        <div style="display:flex;flex-direction:column;gap:12px;" id="milestones-list">
          <% if (inquiry.milestones && inquiry.milestones.length > 0) { %>
            <% inquiry.milestones.forEach((m) => { %>
              <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border:1px solid var(--border);border-radius:6px;background:var(--bg-subtle);">
                <div style="font-size:13.5px;font-weight:600;color:var(--text);"><%= m.title %></div>
                <select class="milestone-status-select status-select" data-id="<%= m.id %>" data-title="<%= m.title %>" style="font-size:11px;padding:4px 8px;">
                  <option value="pending" <%= m.status === 'pending' ? 'selected' : '' %>>Upcoming</option>
                  <option value="in_progress" <%= m.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                  <option value="completed" <%= m.status === 'completed' ? 'selected' : '' %>>Done</option>
                </select>
              </div>
            <% }) %>
          <% } %>
        </div>
        <div style="margin-top:16px;display:flex;justify-content:space-between;align-items:center;">
          <button onclick="copyTrackerLink('<%= trackerUrl %>')" class="btn-ghost" style="font-size:12px;">
            <span class="ms" style="font-size:15px;">content_copy</span> Copy Tracking Link
          </button>
          <button onclick="saveMilestones(<%= inquiry.id %>)" class="btn-primary" style="font-size:12px;padding:8px 16px;">
            <span class="ms" style="font-size:15px;">save</span> Save Milestones
          </button>
        </div>
      </div>
    </div>

    <!-- Admin Notes -->
    <div class="card" style="margin-bottom:20px;">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
        <span style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);">Admin Notes</span>
        <span id="notes-indicator" class="ms" style="font-size:18px;color:var(--text-faint);display:none;">check_circle</span>
      </div>
      <div class="card-body">
        <textarea id="admin-notes" class="notes-area" placeholder="Add follow-up notes, timeline changes, agreement details, or reminders..."><%= inquiry.adminNotes || '' %></textarea>
        <div style="margin-top:12px;display:flex;justify-content:flex-end;">
          <button onclick="saveNotes(<%= inquiry.id %>)" class="btn-primary" style="font-size:12px;padding:8px 16px;">
            <span class="ms" style="font-size:15px;">save</span> Save Notes
          </button>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Toast -->
<div class="toast" id="toast">
  <span class="ms" style="font-size:16px;" id="toast-icon">check_circle</span>
  <span id="toast-msg">Done</span>
</div>

<script>
  function showToast(msg, isError = false) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    document.getElementById('toast-icon').textContent = isError ? 'error' : 'check_circle';
    toast.style.background = isError ? '#c00' : '#111';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3200);
  }

  function copyTrackerLink(url) {
    navigator.clipboard.writeText(url).then(() => {
      showToast('Client tracking link copied!');
    }).catch(err => {
      showToast('Failed to copy link', true);
    });
  }

  async function saveMilestones(id) {
    const selects = document.querySelectorAll('.milestone-status-select');
    const milestones = Array.from(selects).map(sel => ({
      id: parseInt(sel.dataset.id),
      title: sel.dataset.title,
      status: sel.value
    }));

    const ind = document.getElementById('milestone-indicator');
    ind.style.display = 'inline-block';
    ind.textContent = 'progress_activity';
    ind.style.color = 'var(--text-faint)';

    try {
      const response = await fetch(`/api/inquiries/${id}/milestones`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ milestones })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        ind.textContent = 'check_circle';
        ind.style.color = '#16a34a';
        showToast('Milestones saved! Client view updated.');
        setTimeout(() => { ind.style.display = 'none'; }, 2500);
      } else {
        ind.textContent = 'error';
        ind.style.color = '#c00';
        showToast(result.message || 'Failed to save milestones.', true);
      }
    } catch (e) {
      ind.textContent = 'error';
      ind.style.color = '#c00';
      showToast('Server error saving milestones.', true);
    }
  }

  async function updateStatus(id, newStatus) {
    const ind = document.getElementById('status-indicator');
    ind.style.display = 'inline-block';
    ind.textContent = 'progress_activity';
    ind.style.color = 'var(--text-faint)';
    try {
      const response = await fetch(`/api/inquiries/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        ind.textContent = 'check_circle';
        ind.style.color = '#16a34a';
        showToast('Status updated to ' + newStatus);
        setTimeout(() => { ind.style.display = 'none'; }, 2500);
      } else {
        ind.textContent = 'error';
        ind.style.color = '#c00';
        showToast(result.message || 'Failed to update status.', true);
      }
    } catch (e) {
      ind.textContent = 'error';
      ind.style.color = '#c00';
      showToast('Server error.', true);
    }
  }

  async function saveNotes(id) {
    const notes = document.getElementById('admin-notes').value;
    const ind = document.getElementById('notes-indicator');
    ind.style.display = 'inline-block';
    ind.textContent = 'progress_activity';
    ind.style.color = 'var(--text-faint)';
    try {
      const response = await fetch(`/api/inquiries/${id}/notes`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ notes })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        ind.textContent = 'check_circle';
        ind.style.color = '#16a34a';
        showToast('Notes saved successfully.');
        setTimeout(() => { ind.style.display = 'none'; }, 2500);
      } else {
        ind.textContent = 'error';
        ind.style.color = '#c00';
        showToast(result.message || 'Failed to save notes.', true);
      }
    } catch (e) {
      ind.textContent = 'error';
      ind.style.color = '#c00';
      showToast('Server error.', true);
    }
  }

  async function deleteInquiry(id) {
    if (!confirm('Delete this lead permanently? This action cannot be undone.')) return;
    try {
      const response = await fetch(`/api/inquiries/${id}`, { method: 'DELETE' });
      const result = await response.json();
      if (response.ok && result.success) {
        window.location.href = '/admin';
      } else {
        showToast(result.message || 'Failed to delete.', true);
      }
    } catch (e) {
      showToast('Server error.', true);
    }
  }
</script>
</body>
</html>
