<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Inquiry Details | <%= siteConfig.name %></title>
  <!-- Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Geist Font -->
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>
  <style>
    body {
      font-family: 'Geist', sans-serif;
    }
  </style>
</head>
<body class="bg-surface-container-lowest text-on-surface antialiased flex flex-col min-h-screen">

  <!-- Header -->
  <header class="fixed top-0 w-full z-50 bg-surface-container-lowest border-b border-outline-variant">
    <div class="flex justify-between items-center h-20 px-lg md:px-xl max-w-container-max mx-auto">
      <div class="flex items-center gap-sm">
        <span class="material-symbols-outlined text-primary" data-weight="fill" style="font-variation-settings: 'FILL' 1;">terminal</span>
        <span class="font-headline-md text-headline-md font-bold text-primary tracking-tighter"><%= siteConfig.name %> <span class="font-normal text-secondary text-sm px-xs py-[2px] border border-outline-variant uppercase">Admin</span></span>
      </div>
      <div class="flex gap-md items-center">
        <a href="/admin" class="text-secondary hover:text-primary font-body-md text-body-md transition-colors flex items-center gap-xs">
          <span class="material-symbols-outlined text-base">arrow_back</span> Back to Dashboard
        </a>
      </div>
    </div>
  </header>

  <!-- Inquiry Details View -->
  <main class="flex-1 max-w-3xl w-full mx-auto px-lg pt-28 pb-xxl">
    <div class="border border-outline-variant p-lg md:p-xl bg-surface-container-lowest">
      
      <!-- ID and Status Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-md border-b border-outline-variant pb-md mb-lg">
        <div>
          <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">LEAD #<%= inquiry.id %></span>
          <h1 class="font-headline-lg-mobile text-headline-lg-mobile font-bold text-primary tracking-tight mt-xs"><%= inquiry.fullName %></h1>
        </div>
        
        <!-- Status Changer -->
        <div class="flex items-center gap-sm">
          <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">STATUS</span>
          <div class="relative">
            <select id="status-select" onchange="updateInquiryStatus(<%= inquiry.id %>, this.value)"
              class="bg-surface-container-lowest border border-outline-variant px-md py-sm text-body-md text-primary font-medium focus:border-primary focus:ring-0 focus:outline-none cursor-pointer">
              <% ['NEW', 'CONTACTED', 'IN DISCUSSION', 'IN PROGRESS', 'COMPLETED', 'REJECTED'].forEach(status => { %>
                <option value="<%= status %>" <%= inquiry.status === status ? 'selected' : '' %>><%= status %></option>
              <% }) %>
            </select>
          </div>
          <span id="status-update-indicator" class="material-symbols-outlined text-green-600 text-base hidden">check</span>
        </div>
      </div>

      <!-- Grid: Client and Project -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-xl mb-xl">
        <!-- Client Details -->
        <div>
          <h3 class="font-label-sm-caps text-label-sm-caps text-primary uppercase tracking-widest border-b border-outline-variant pb-xs mb-md">Client Details</h3>
          <table class="w-full text-left space-y-sm text-body-md">
            <tr>
              <td class="text-secondary font-medium py-xs w-28">Name</td>
              <td class="text-primary py-xs font-bold"><%= inquiry.fullName %></td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">Email</td>
              <td class="text-primary py-xs"><a href="mailto:<%= inquiry.email %>" class="underline hover:text-secondary transition-colors"><%= inquiry.email %></a></td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">WhatsApp</td>
              <td class="text-primary py-xs">
                <% if (inquiry.whatsapp) { %>
                  <a href="https://wa.me/<%= inquiry.whatsapp.replace(/[^\d+]/g, '') %>" target="_blank" rel="noopener noreferrer" class="underline hover:text-secondary transition-colors">
                    <%= inquiry.whatsapp %>
                  </a>
                <% } else { %>
                  —
                <% } %>
              </td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">Company</td>
              <td class="text-primary py-xs"><%= inquiry.company || '—' %></td>
            </tr>
          </table>
        </div>

        <!-- Project Details -->
        <div>
          <h3 class="font-label-sm-caps text-label-sm-caps text-primary uppercase tracking-widest border-b border-outline-variant pb-xs mb-md">Project Request</h3>
          <table class="w-full text-left space-y-sm text-body-md">
            <tr>
              <td class="text-secondary font-medium py-xs w-28">Type</td>
              <td class="text-primary py-xs font-bold"><%= inquiry.projectType %></td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">Budget</td>
              <td class="text-primary py-xs"><%= inquiry.budget %></td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">Timeline</td>
              <td class="text-primary py-xs"><%= inquiry.timeline %></td>
            </tr>
            <tr>
              <td class="text-secondary font-medium py-xs">Current Site</td>
              <td class="text-primary py-xs">
                <% if (inquiry.website) { %>
                  <a href="<%= inquiry.website %>" target="_blank" rel="noopener noreferrer" class="underline hover:text-secondary transition-colors truncate max-w-[150px] inline-block">
                    <%= inquiry.website %>
                  </a>
                <% } else { %>
                  —
                <% } %>
              </td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Project Description -->
      <div class="mb-xl">
        <h3 class="font-label-sm-caps text-label-sm-caps text-primary uppercase tracking-widest border-b border-outline-variant pb-xs mb-md">Project Objectives & Details</h3>
        <div class="bg-surface p-md border border-outline-variant">
          <p class="font-body-md text-body-md text-primary whitespace-pre-wrap leading-relaxed"><%= inquiry.description %></p>
        </div>
      <!-- Administrative Notes -->
      <div class="mb-xl">
        <div class="flex justify-between items-center border-b border-outline-variant pb-xs mb-md">
          <h3 class="font-label-sm-caps text-label-sm-caps text-primary uppercase tracking-widest">Administrative Notes</h3>
          <span id="notes-update-indicator" class="material-symbols-outlined text-green-600 text-base hidden">check</span>
        </div>
        <div class="flex flex-col gap-sm">
          <textarea id="admin-notes" rows="4" placeholder="Add follow-up notes, timeline modifications, or agreement details..."
            class="w-full bg-surface-container-lowest border border-outline-variant p-md focus:border-primary focus:ring-0 focus:outline-none rounded-DEFAULT text-body-md text-primary resize-y"><%= inquiry.adminNotes || '' %></textarea>
          <div class="text-right">
            <button onclick="saveAdminNotes(<%= inquiry.id %>)" 
              class="inline-flex items-center gap-xs bg-primary text-on-primary font-body-md text-body-md px-md py-sm hover:opacity-85 transition-opacity cursor-pointer">
              <span class="material-symbols-outlined text-base">save</span> Save Notes
            </button>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="border-t border-outline-variant pt-lg flex flex-col sm:flex-row items-center justify-between gap-md">
        <div class="flex flex-wrap gap-md w-full sm:w-auto">
          <!-- Email CTA -->
          <% 
            const emailSubject = encodeURIComponent(`Project Inquiry — ${siteConfig.name}`);
            const emailBody = encodeURIComponent(`Hi ${inquiry.fullName},\n\nThanks for reaching out about your ${inquiry.projectType} project! I have reviewed your request details:\n\n"${inquiry.description}"\n\nI would love to connect and discuss this further. Let me know when you are available for a quick chat.\n\nBest regards,\n${siteConfig.name}`);
          %>
          <a href="mailto:<%= inquiry.email %>?subject=<%= emailSubject %>&body=<%= emailBody %>" 
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-xs bg-primary text-on-primary font-body-md text-body-md px-md py-sm hover:opacity-85 transition-opacity text-center">
            <span class="material-symbols-outlined text-base">mail</span> Email Client
          </a>
          
          <!-- WhatsApp CTA -->
          <% 
            const waText = encodeURIComponent(`Hi ${inquiry.fullName}, this is ${siteConfig.name}. I received your project request for a ${inquiry.projectType} and would love to connect.`);
            const waHref = `https://wa.me/${inquiry.whatsapp.replace(/[^\d+]/g, '')}?text=${waText}`;
          %>
          <a href="<%= waHref %>" target="_blank" rel="noopener noreferrer" 
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-xs border border-outline-variant text-primary hover:bg-surface font-body-md text-body-md px-md py-sm transition-colors text-center">
            <span class="material-symbols-outlined text-base">chat</span> WhatsApp Client
          </a>
        </div>

        <div>
          <button onclick="deleteInquiry(<%= inquiry.id %>)" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-xs border border-error text-error hover:bg-error-container/20 font-body-md text-body-md px-md py-sm transition-colors cursor-pointer">
            <span class="material-symbols-outlined text-base">delete</span> Delete Inquiry
          </button>
        </div>
      </div>
      
    </div>
  </main>

  <footer class="bg-surface-container-lowest border-t border-outline-variant py-md text-center text-xs text-secondary mt-auto">
    <%= siteConfig.name %> Admin Panel &copy; <%= new Date().getFullYear() %>
  </footer>

  <script>
    async function updateInquiryStatus(id, newStatus) {
      const indicator = document.getElementById('status-update-indicator');
      indicator.className = "material-symbols-outlined text-secondary animate-spin text-base block";
      indicator.textContent = "progress_activity";
      
      try {
        const response = await fetch(`/api/inquiries/${id}/status`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        const result = await response.json();
        
        if (response.ok && result.success) {
          indicator.className = "material-symbols-outlined text-green-600 text-base block";
          indicator.textContent = "check";
          setTimeout(() => {
            indicator.classList.add('hidden');
          }, 2000);
        } else {
          indicator.className = "material-symbols-outlined text-error text-base block";
          indicator.textContent = "error";
          alert(result.message || 'Failed to update status.');
        }
      } catch (error) {
        console.error('Status update error:', error);
        indicator.className = "material-symbols-outlined text-error text-base block";
        indicator.textContent = "error";
        alert('Server error while updating status.');
      }
    }

    async function saveAdminNotes(id) {
      const notesText = document.getElementById('admin-notes').value;
      const indicator = document.getElementById('notes-update-indicator');
      
      indicator.className = "material-symbols-outlined text-secondary animate-spin text-base block";
      indicator.textContent = "progress_activity";
      
      try {
        const response = await fetch(`/api/inquiries/${id}/notes`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ notes: notesText })
        });
        const result = await response.json();
        
        if (response.ok && result.success) {
          indicator.className = "material-symbols-outlined text-green-600 text-base block";
          indicator.textContent = "check";
          setTimeout(() => {
            indicator.classList.add('hidden');
          }, 2000);
        } else {
          indicator.className = "material-symbols-outlined text-error text-base block";
          indicator.textContent = "error";
          alert(result.message || 'Failed to save notes.');
        }
      } catch (error) {
        console.error('Notes save error:', error);
        indicator.className = "material-symbols-outlined text-error text-base block";
        indicator.textContent = "error";
        alert('Server error while saving notes.');
      }
    }

    async function deleteInquiry(id) {
      if (!confirm('Are you sure you want to delete this lead inquiry permanently?')) {
        return;
      }
      try {
        const response = await fetch(`/api/inquiries/${id}`, {
          method: 'DELETE'
        });
        const result = await response.json();
        if (response.ok && result.success) {
          window.location.href = '/admin';
        } else {
          alert(result.message || 'Failed to delete inquiry.');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('Server error while deleting inquiry.');
      }
    }
  </script>
</body>
</html>
