<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Admin Dashboard | <%= siteConfig.name %></title>
  <!-- Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Geist Font -->
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>
  <style>
    body {
      font-family: 'Geist', sans-serif;
    }
  </style>
</head>
<body class="bg-surface-container-lowest text-on-surface antialiased flex flex-col min-h-screen">

  <!-- Header -->
  <header class="fixed top-0 w-full z-50 bg-surface-container-lowest border-b border-outline-variant">
    <div class="flex justify-between items-center h-20 px-lg md:px-xl max-w-container-max mx-auto">
      <div class="flex items-center gap-sm">
        <span class="material-symbols-outlined text-primary" data-weight="fill" style="font-variation-settings: 'FILL' 1;">terminal</span>
        <span class="font-headline-md text-headline-md font-bold text-primary tracking-tighter"><%= siteConfig.name %> <span class="font-normal text-secondary text-sm px-xs py-[2px] border border-outline-variant uppercase">Admin</span></span>
      </div>
      <div class="flex gap-md items-center">
        <a href="/" class="text-secondary hover:text-primary font-body-md text-body-md transition-colors" target="_blank">View Site</a>
        <a href="/admin/logout" class="bg-primary text-on-primary font-body-md text-body-md px-md py-sm hover:opacity-85 transition-opacity">Logout</a>
      </div>
    </div>
  </header>

  <!-- Main Dashboard Content -->
  <main class="flex-1 max-w-container-max w-full mx-auto px-lg md:px-xl pt-28 pb-xxl">
    <!-- Summary Cards & Chart -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-md mb-md">
      <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest flex flex-col justify-between">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">TOTAL LEADS</span>
        <span class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary"><%= stats.total %></span>
      </div>
      <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest flex flex-col justify-between">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">NEW LEADS</span>
        <span class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary"><%= stats.newCount %></span>
      </div>
      <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest flex flex-col justify-between">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">IN DISCUSSION</span>
        <span class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary"><%= stats.discussionCount %></span>
      </div>
      <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest flex flex-col justify-between">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">IN PROGRESS</span>
        <span class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary"><%= stats.progressCount %></span>
      </div>
      <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest flex flex-col justify-between">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">COMPLETED</span>
        <span class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary"><%= stats.completedCount %></span>
      </div>
    </div>

    <!-- Leads Distribution Stacked Bar Chart -->
    <div class="border border-outline-variant p-md md:p-lg bg-surface-container-lowest mb-xl flex flex-col gap-sm">
      <div class="flex justify-between items-center">
        <span class="font-label-sm-caps text-[10px] text-secondary tracking-widest uppercase">LEADS PROGRESSION</span>
        <span class="text-xs text-secondary font-medium"><%= stats.total %> Total Leads</span>
      </div>
      <% 
        const newPct = (stats.newCount / (stats.total || 1) * 100) || 0;
        const discPct = (stats.discussionCount / (stats.total || 1) * 100) || 0;
        const progPct = (stats.progressCount / (stats.total || 1) * 100) || 0;
        const compPct = (stats.completedCount / (stats.total || 1) * 100) || 0;
        const otherPct = Math.max(0, 100 - (newPct + discPct + progPct + compPct));
      %>
      <div class="w-full h-3 bg-surface-container flex border border-outline-variant rounded-DEFAULT overflow-hidden">
        <% if (stats.newCount > 0) { %><div style="width: <%= newPct %>%;" class="bg-primary hover:opacity-80 transition-opacity" title="New: <%= stats.newCount %>"></div><% } %>
        <% if (stats.discussionCount > 0) { %><div style="width: <%= discPct %>%;" class="bg-secondary hover:opacity-80 transition-opacity" title="In Discussion: <%= stats.discussionCount %>"></div><% } %>
        <% if (stats.progressCount > 0) { %><div style="width: <%= progPct %>%;" class="bg-surface-dim hover:opacity-80 transition-opacity border-l border-outline-variant" title="In Progress: <%= stats.progressCount %>"></div><% } %>
        <% if (stats.completedCount > 0) { %><div style="width: <%= compPct %>%;" class="bg-surface-container-highest hover:opacity-80 transition-opacity border-l border-outline-variant" title="Completed: <%= stats.completedCount %>"></div><% } %>
        <% if (stats.total === 0) { %><div style="width: 100%;" class="bg-surface-container" title="No Leads"></div><% } %>
      </div>
      <div class="flex flex-wrap gap-md justify-start text-[11px] text-secondary mt-xs">
        <span class="flex items-center gap-xs"><span class="w-2.5 h-2.5 bg-primary inline-block border border-outline-variant rounded-DEFAULT"></span> New (<%= stats.newCount %>)</span>
        <span class="flex items-center gap-xs"><span class="w-2.5 h-2.5 bg-secondary inline-block border border-outline-variant rounded-DEFAULT"></span> In Discussion (<%= stats.discussionCount %>)</span>
        <span class="flex items-center gap-xs"><span class="w-2.5 h-2.5 bg-surface-dim inline-block border border-outline-variant rounded-DEFAULT"></span> In Progress (<%= stats.progressCount %>)</span>
        <span class="flex items-center gap-xs"><span class="w-2.5 h-2.5 bg-surface-container-highest inline-block border border-outline-variant rounded-DEFAULT"></span> Completed (<%= stats.completedCount %>)</span>
      </div>
    </div>

    <!-- Filters & Search -->
    <div class="flex flex-col md:flex-row gap-md items-stretch justify-between mb-lg border-b border-outline-variant pb-md">
      <!-- Status Tabs -->
      <div class="flex flex-wrap gap-xs items-center">
        <% ['All', 'New', 'Contacted', 'In Discussion', 'In Progress', 'Completed', 'Rejected'].forEach(filter => { %>
          <a href="/admin?filter=<%= filter %>&search=<%= searchQuery %>" 
            class="px-md py-sm font-body-md text-body-md border transition-all <%= activeFilter === filter ? 'bg-primary text-on-primary border-primary' : 'bg-transparent text-secondary border-outline-variant hover:text-primary hover:border-primary' %>">
            <%= filter %>
          </a>
        <% }) %>
        
        <a href="/admin/export" class="inline-flex items-center justify-center gap-xs px-md py-sm border border-outline-variant text-secondary hover:text-primary hover:border-primary font-body-md text-body-md transition-all rounded-DEFAULT ml-xs" title="Download Leads as JSON">
          <span class="material-symbols-outlined text-base">download</span> Export JSON
        </a>
      </div>
      
      <!-- Search Input -->
      <form action="/admin" method="GET" class="flex gap-xs w-full md:w-auto">
        <input type="hidden" name="filter" value="<%= activeFilter %>">
        <input type="text" name="search" value="<%= searchQuery %>" placeholder="Search leads..." 
          class="flex-1 md:w-64 bg-surface-container-lowest border border-outline-variant px-md py-sm text-body-md text-primary focus:border-primary focus:ring-0 focus:outline-none rounded-DEFAULT">
        <button type="submit" class="bg-primary text-on-primary p-sm border border-primary hover:opacity-85 transition-opacity cursor-pointer">
          <span class="material-symbols-outlined text-base">search</span>
        </button>
        <% if (searchQuery) { %>
          <a href="/admin?filter=<%= activeFilter %>" class="border border-outline-variant text-secondary p-sm flex items-center hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-base">close</span>
          </a>
        <% } %>
      </form>
    </div>

    <!-- Lead List Table -->
    <div class="border border-outline-variant overflow-x-auto bg-surface-container-lowest">
      <% if (inquiries && inquiries.length > 0) { %>
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-outline-variant bg-surface">
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider">Client / Company</th>
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider">Project Type</th>
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider">Budget</th>
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider">Status</th>
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider">Submitted</th>
              <th class="font-label-sm-caps text-label-sm-caps text-secondary p-md uppercase tracking-wider text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% inquiries.forEach(inquiry => { %>
              <tr class="border-b border-outline-variant hover:bg-surface transition-colors cursor-pointer" onclick="window.location.href='/admin/inquiries/<%= inquiry.id %>'">
                <!-- Client & Company -->
                <td class="p-md">
                  <div class="font-body-md text-body-md font-bold text-primary"><%= inquiry.fullName %></div>
                  <div class="text-xs text-secondary"><%= inquiry.company || '—' %></div>
                </td>
                
                <!-- Project Type -->
                <td class="p-md text-body-md text-primary font-medium">
                  <%= inquiry.projectType %>
                </td>
                
                <!-- Budget -->
                <td class="p-md text-body-md text-secondary">
                  <%= inquiry.budget %>
                </td>
                
                <!-- Status Badge with Inline Selector -->
                <td class="p-md" onclick="event.stopPropagation();">
                  <select onchange="updateInquiryStatus(<%= inquiry.id %>, this.value)" 
                    class="bg-surface-container-lowest border border-outline-variant px-sm py-[2px] text-xs font-semibold text-primary focus:border-primary focus:ring-0 focus:outline-none cursor-pointer uppercase tracking-wider rounded-DEFAULT">
                    <% ['NEW', 'CONTACTED', 'IN DISCUSSION', 'IN PROGRESS', 'COMPLETED', 'REJECTED'].forEach(status => { %>
                      <option value="<%= status %>" <%= inquiry.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }) %>
                  </select>
                </td>
                
                <!-- Submitted Date -->
                <td class="p-md text-body-md text-secondary">
                  <%= new Date(inquiry.createdAt).toLocaleDateString(undefined, {month: 'short', day: 'numeric', year: 'numeric'}) %>
                </td>
                
                <!-- Actions -->
                <td class="p-md text-right" onclick="event.stopPropagation();">
                  <div class="flex items-center justify-end gap-sm">
                    <a href="/admin/inquiries/<%= inquiry.id %>" class="text-secondary hover:text-primary p-xs flex" title="View details">
                      <span class="material-symbols-outlined text-lg">visibility</span>
                    </a>
                    <% if (inquiry.whatsapp) { %>
                      <a href="https://wa.me/<%= inquiry.whatsapp.replace(/[^\d+]/g, '') %>" target="_blank" rel="noopener noreferrer" class="text-secondary hover:text-primary p-xs flex" title="WhatsApp client">
                        <span class="material-symbols-outlined text-lg">chat</span>
                      </a>
                    <% } %>
                    <button onclick="deleteInquiry(<%= inquiry.id %>)" class="text-secondary hover:text-error p-xs flex cursor-pointer" title="Delete lead">
                      <span class="material-symbols-outlined text-lg">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <!-- Upgraded Minimalist Empty State -->
        <div class="text-center py-20 border-t border-outline-variant bg-surface-container-lowest flex flex-col items-center justify-center p-lg">
          <div class="w-12 h-12 flex items-center justify-center rounded-full border border-outline-variant mb-md bg-surface">
            <span class="material-symbols-outlined text-secondary text-2xl">inbox</span>
          </div>
          <h3 class="font-headline-md text-headline-md font-bold text-primary mb-xs tracking-tight">No project inquiries yet</h3>
          <p class="font-body-md text-body-md text-secondary max-w-sm mb-lg">
            Client project requests submitted through your website contact form will automatically appear here in real-time.
          </p>
          <div class="flex gap-md">
            <a href="/" target="_blank" class="inline-flex items-center gap-xs px-md py-sm bg-primary text-on-primary font-body-md text-body-md hover:bg-secondary transition-all">
              Go to Landing Page <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
            <button onclick="window.location.reload()" class="inline-flex items-center gap-xs px-md py-sm border border-outline-variant text-secondary hover:text-primary hover:border-primary font-body-md text-body-md transition-all cursor-pointer">
              <span class="material-symbols-outlined text-sm">refresh</span> Refresh List
            </button>
          </div>
        </div>
      <% } %>
    </div>
  </main>

  <footer class="bg-surface-container-lowest border-t border-outline-variant py-md text-center text-xs text-secondary mt-auto">
    <%= siteConfig.name %> Admin Panel &copy; <%= new Date().getFullYear() %>
  </footer>

  <script>
    async function updateInquiryStatus(id, newStatus) {
      try {
        const response = await fetch(`/api/inquiries/${id}/status`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          alert(result.message || 'Failed to update status.');
        }
      } catch (error) {
        console.error('Status update error:', error);
        alert('Server error while updating status.');
      }
    }

    async function deleteInquiry(id) {
      if (!confirm('Are you sure you want to delete this lead inquiry permanently?')) {
        return;
      }
      try {
        const response = await fetch(`/api/inquiries/${id}`, {
          method: 'DELETE'
        });
        const result = await response.json();
        if (response.ok && result.success) {
          window.location.reload();
        } else {
          alert(result.message || 'Failed to delete inquiry.');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('Server error while deleting inquiry.');
      }
    }
  </script>
</body>
</html>
