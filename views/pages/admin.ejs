<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title>Admin Dashboard | <%= siteConfig.name %></title>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { font-family: 'Geist', sans-serif; }
    .ms { font-family: 'Material Symbols Outlined'; font-weight: normal; font-style: normal; font-size: 20px; line-height: 1; letter-spacing: normal; text-transform: none; display: inline-block; white-space: nowrap; word-wrap: normal; direction: ltr; -webkit-font-smoothing: antialiased; }
    
    :root {
      --border: #e2e2e2;
      --bg: #ffffff;
      --bg-subtle: #f7f7f7;
      --bg-muted: #f0f0f0;
      --text: #111111;
      --text-muted: #666666;
      --text-faint: #999999;
    }

    body { background: var(--bg); color: var(--text); }

    /* Sidebar */
    .sidebar { width: 240px; min-height: 100vh; border-right: 1px solid var(--border); background: var(--bg); position: fixed; left: 0; top: 0; z-index: 40; display: flex; flex-direction: column; }
    .sidebar-logo { padding: 24px 20px; border-bottom: 1px solid var(--border); }
    .sidebar-nav { flex: 1; padding: 12px 12px; }
    .nav-item { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 6px; font-size: 14px; font-weight: 500; color: var(--text-muted); text-decoration: none; transition: all 0.15s ease; cursor: pointer; border: none; background: none; width: 100%; text-align: left; }
    .nav-item:hover { background: var(--bg-subtle); color: var(--text); }
    .nav-item.active { background: var(--text); color: #ffffff; }
    .nav-item .ms { font-size: 18px; }
    .nav-section { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-faint); padding: 16px 12px 6px; }
    .sidebar-footer { padding: 16px 12px; border-top: 1px solid var(--border); }

    /* Main content */
    .main-content { margin-left: 240px; min-height: 100vh; }
    .topbar { height: 56px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 32px; background: var(--bg); position: sticky; top: 0; z-index: 30; }

    /* Stat cards */
    .stat-card { border: 1px solid var(--border); padding: 20px 24px; background: var(--bg); position: relative; overflow: hidden; }
    .stat-card:hover { background: var(--bg-subtle); }
    .stat-value { font-size: 32px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--text); }
    .stat-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 8px; }
    .stat-pill { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; padding: 2px 8px; border-radius: 99px; border: 1px solid var(--border); color: var(--text-muted); margin-top: 10px; }

    /* Status badges */
    .badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border: 1px solid; border-radius: 3px; }
    .badge-new { background: #f5f5f5; color: #333; border-color: #d4d4d4; }
    .badge-contacted { background: #fafafa; color: #555; border-color: #ddd; }
    .badge-discussion { background: #f0f0f0; color: #444; border-color: #ccc; }
    .badge-progress { background: #1a1a1a; color: #fff; border-color: #111; }
    .badge-completed { background: #111; color: #fff; border-color: #000; }
    .badge-rejected { background: #fff0f0; color: #c00; border-color: #fcc; }

    /* Table */
    .leads-table { width: 100%; border-collapse: collapse; }
    .leads-table th { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); padding: 12px 16px; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; background: var(--bg-subtle); }
    .leads-table td { padding: 14px 16px; border-bottom: 1px solid var(--border); font-size: 13.5px; color: var(--text); vertical-align: middle; }
    .leads-table tr:last-child td { border-bottom: none; }
    .leads-table tbody tr { cursor: pointer; transition: background 0.1s ease; }
    .leads-table tbody tr:hover { background: var(--bg-subtle); }

    /* Inline status select */
    .status-select { font-size: 10px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; padding: 4px 8px; border: 1px solid var(--border); background: var(--bg); color: var(--text); cursor: pointer; border-radius: 3px; outline: none; }
    .status-select:focus { border-color: var(--text); }

    /* Filter tabs */
    .filter-tab { font-size: 12px; font-weight: 500; padding: 6px 12px; border: 1px solid transparent; border-radius: 4px; color: var(--text-muted); text-decoration: none; transition: all 0.12s ease; }
    .filter-tab:hover { color: var(--text); background: var(--bg-subtle); }
    .filter-tab.active { background: var(--text); color: #fff; border-color: var(--text); }

    /* Search */
    .search-input { font-size: 13px; padding: 7px 12px; border: 1px solid var(--border); background: var(--bg); color: var(--text); width: 220px; outline: none; border-radius: 5px; }
    .search-input:focus { border-color: var(--text); }

    /* Buttons */
    .btn-primary { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 8px 16px; background: var(--text); color: #fff; border: 1px solid var(--text); border-radius: 5px; cursor: pointer; text-decoration: none; transition: opacity 0.15s; }
    .btn-primary:hover { opacity: 0.85; }
    .btn-ghost { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 500; padding: 7px 14px; background: transparent; color: var(--text-muted); border: 1px solid var(--border); border-radius: 5px; cursor: pointer; text-decoration: none; transition: all 0.12s; }
    .btn-ghost:hover { color: var(--text); border-color: var(--text); background: var(--bg-subtle); }

    /* Avatar */
    .avatar { width: 32px; height: 32px; background: var(--text); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; flex-shrink: 0; }

    /* Sparkline bar */
    .progress-bar { height: 4px; background: var(--bg-muted); border-radius: 99px; overflow: hidden; margin-top: 14px; }
    .progress-fill { height: 100%; background: var(--text); border-radius: 99px; transition: width 0.4s ease; }

    /* Mobile sidebar toggle */
    .mobile-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 35; }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); transition: transform 0.2s ease; }
      .sidebar.open { transform: translateX(0); }
      .mobile-overlay.open { display: block; }
      .main-content { margin-left: 0; }
    }

    /* Toast */
    .toast { position: fixed; bottom: 24px; right: 24px; background: var(--text); color: #fff; font-size: 13px; padding: 12px 18px; border-radius: 6px; transform: translateY(100px); opacity: 0; transition: all 0.2s ease; z-index: 99; display: flex; align-items: center; gap: 8px; }
    .toast.show { transform: translateY(0); opacity: 1; }
  </style>
</head>
<body>

<!-- Mobile Overlay -->
<div class="mobile-overlay" id="overlay" onclick="closeSidebar()"></div>

<!-- Sidebar -->
<aside class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div style="display:flex;align-items:center;gap:8px;">
      <span class="ms" style="font-size:20px;font-variation-settings:'FILL' 1;">terminal</span>
      <div>
        <div style="font-size:14px;font-weight:700;letter-spacing:-0.02em;line-height:1.2;"><%= siteConfig.name %></div>
        <div style="font-size:10px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-faint);margin-top:1px;">Admin Panel</div>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">Workspace</div>
    <a href="/admin" class="nav-item active">
      <span class="ms">grid_view</span> Dashboard
    </a>
    <a href="/admin?filter=New" class="nav-item">
      <span class="ms">fiber_new</span> New Leads
      <% if (stats.newCount > 0) { %>
        <span style="margin-left:auto;background:#111;color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px;"><%= stats.newCount %></span>
      <% } %>
    </a>
    <a href="/admin?filter=In Progress" class="nav-item">
      <span class="ms">pending</span> In Progress
    </a>
    <a href="/admin?filter=Completed" class="nav-item">
      <span class="ms">check_circle</span> Completed
    </a>

    <div class="nav-section" style="margin-top:8px;">Actions</div>
    <a href="/admin/export" class="nav-item">
      <span class="ms">download</span> Export JSON
    </a>
    <a href="/" target="_blank" class="nav-item">
      <span class="ms">open_in_new</span> View Site
    </a>
  </nav>

  <div class="sidebar-footer">
    <a href="/admin/logout" class="nav-item" style="color:#c00;">
      <span class="ms">logout</span> Sign Out
    </a>
  </div>
</aside>

<!-- Main Content -->
<div class="main-content">

  <!-- Topbar -->
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <button onclick="toggleSidebar()" class="btn-ghost" style="padding:6px 8px;display:none;" id="menu-btn">
        <span class="ms" style="font-size:20px;">menu</span>
      </button>
      <div>
        <span style="font-size:13px;font-weight:600;color:var(--text);">Dashboard</span>
        <span style="font-size:13px;color:var(--text-faint);margin-left:6px;">/ Leads</span>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;">
      <form action="/admin" method="GET" style="display:flex;gap:6px;align-items:center;">
        <input type="hidden" name="filter" value="<%= activeFilter %>">
        <input type="text" name="search" value="<%= searchQuery %>" placeholder="Search leads..." class="search-input">
        <button type="submit" class="btn-primary" style="padding:7px 12px;">
          <span class="ms" style="font-size:16px;">search</span>
        </button>
        <% if (searchQuery) { %>
          <a href="/admin?filter=<%= activeFilter %>" class="btn-ghost" style="padding:7px 10px;" title="Clear search">
            <span class="ms" style="font-size:16px;">close</span>
          </a>
        <% } %>
      </form>
    </div>
  </header>

  <!-- Page Content -->
  <div style="padding:32px;">

    <!-- Page heading -->
    <div style="margin-bottom:28px;">
      <h1 style="font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--text);line-height:1.2;">Client Inquiries</h1>
      <p style="font-size:13px;color:var(--text-muted);margin-top:4px;">Track, manage, and follow up on project leads.</p>
    </div>

    <!-- Stats Grid -->
    <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:28px;" class="stats-grid">
      <div class="stat-card">
        <div class="stat-label">Total Leads</div>
        <div class="stat-value"><%= stats.total %></div>
        <div class="progress-bar"><div class="progress-fill" style="width:100%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">New</div>
        <div class="stat-value"><%= stats.newCount %></div>
        <div class="progress-bar"><div class="progress-fill" style="width:<%= stats.total > 0 ? (stats.newCount/stats.total*100) : 0 %>%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">In Discussion</div>
        <div class="stat-value"><%= stats.discussionCount %></div>
        <div class="progress-bar"><div class="progress-fill" style="width:<%= stats.total > 0 ? (stats.discussionCount/stats.total*100) : 0 %>%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">In Progress</div>
        <div class="stat-value"><%= stats.progressCount %></div>
        <div class="progress-bar"><div class="progress-fill" style="width:<%= stats.total > 0 ? (stats.progressCount/stats.total*100) : 0 %>%;"></div></div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Completed</div>
        <div class="stat-value"><%= stats.completedCount %></div>
        <div class="progress-bar"><div class="progress-fill" style="width:<%= stats.total > 0 ? (stats.completedCount/stats.total*100) : 0 %>%;"></div></div>
      </div>
    </div>

    <!-- Filter Tabs + Actions Row -->
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
      <div style="display:flex;gap:4px;flex-wrap:wrap;">
        <% ['All', 'New', 'Contacted', 'In Discussion', 'In Progress', 'Completed', 'Rejected', 'Subscribers'].forEach(filter => { %>
          <a href="/admin?filter=<%= filter %>&search=<%= searchQuery %>" 
            class="filter-tab <%= activeFilter === filter ? 'active' : '' %>">
            <%= filter %> <%= filter === 'Subscribers' ? `(${subscribersCount})` : '' %>
          </a>
        <% }) %>
      </div>
      <a href="/admin/export" class="btn-ghost" style="font-size:12px;">
        <span class="ms" style="font-size:16px;">download</span> Export JSON
      </a>
    </div>

    <!-- Leads Table -->
    <div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;background:var(--bg);">
      <% if (activeFilter === 'Subscribers') { %>
        <% if (subscribers && subscribers.length > 0) { %>
          <table class="leads-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Subscriber Email</th>
                <th>Subscribed Date</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% subscribers.forEach(sub => { %>
                <tr>
                  <td style="color:var(--text-faint);font-weight:600;"><%= sub.id %></td>
                  <td style="font-weight:600;color:var(--text);"><a href="mailto:<%= sub.email %>" style="color:var(--text);text-decoration:underline;"><%= sub.email %></a></td>
                  <td style="color:var(--text-muted);"><%= new Date(sub.subscribedAt).toLocaleDateString(undefined, {weekday:'short',month:'short',day:'numeric',year:'numeric'}) %></td>
                  <td style="text-align:right;">
                    <a href="mailto:<%= sub.email %>?subject=Welcome%20from%20Harshil%20Goyal" class="btn-ghost" style="padding:4px 10px;font-size:12px;">
                      <span class="ms" style="font-size:15px;">mail</span> Email
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } else { %>
          <div style="padding:60px 20px;text-align:center;color:var(--text-muted);">
            <span class="ms" style="font-size:32px;color:var(--text-faint);margin-bottom:8px;">mark_email_read</span>
            <p style="font-size:14px;font-weight:600;">No subscribers yet</p>
            <p style="font-size:12px;color:var(--text-faint);margin-top:4px;">Visitors who subscribe on your website will appear here.</p>
          </div>
        <% } %>
      <% } else if (inquiries && inquiries.length > 0) { %>
        <table class="leads-table">
          <thead>
            <tr>
              <th>Client</th>
              <th>Project Type</th>
              <th>Budget</th>
              <th>Timeline</th>
              <th>Status</th>
              <th>Date</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% inquiries.forEach(inquiry => { %>
              <% 
                const badgeClass = {
                  'NEW': 'badge-new',
                  'CONTACTED': 'badge-contacted',
                  'IN DISCUSSION': 'badge-discussion',
                  'IN PROGRESS': 'badge-progress',
                  'COMPLETED': 'badge-completed',
                  'REJECTED': 'badge-rejected'
                }[inquiry.status] || 'badge-new';
              %>
              <tr onclick="window.location.href='/admin/inquiries/<%= inquiry.id %>'">
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div class="avatar"><%= inquiry.fullName.charAt(0).toUpperCase() %></div>
                    <div>
                      <div style="font-weight:600;font-size:13.5px;"><%= inquiry.fullName %></div>
                      <div style="font-size:12px;color:var(--text-muted);margin-top:1px;"><%= inquiry.company || inquiry.email %></div>
                    </div>
                  </div>
                </td>
                <td style="font-weight:500;"><%= inquiry.projectType %></td>
                <td style="color:var(--text-muted);"><%= inquiry.budget %></td>
                <td style="color:var(--text-muted);"><%= inquiry.timeline %></td>
                <td onclick="event.stopPropagation();">
                  <select onchange="updateInquiryStatus(<%= inquiry.id %>, this.value)" class="status-select">
                    <% ['NEW', 'CONTACTED', 'IN DISCUSSION', 'IN PROGRESS', 'COMPLETED', 'REJECTED'].forEach(status => { %>
                      <option value="<%= status %>" <%= inquiry.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }) %>
                  </select>
                </td>
                <td style="color:var(--text-muted);white-space:nowrap;font-size:12.5px;">
                  <%= new Date(inquiry.createdAt).toLocaleDateString(undefined, {month:'short',day:'numeric',year:'numeric'}) %>
                </td>
                <td onclick="event.stopPropagation();" style="text-align:right;">
                  <div style="display:flex;align-items:center;justify-content:flex-end;gap:4px;">
                    <a href="/admin/inquiries/<%= inquiry.id %>" class="btn-ghost" style="padding:5px 8px;" title="View">
                      <span class="ms" style="font-size:16px;">open_in_new</span>
                    </a>
                    <% if (inquiry.whatsapp) { %>
                      <a href="https://wa.me/<%= inquiry.whatsapp.replace(/[^\d+]/g, '') %>" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="padding:5px 8px;" title="WhatsApp">
                        <span class="ms" style="font-size:16px;">chat</span>
                      </a>
                    <% } %>
                    <button onclick="deleteInquiry(<%= inquiry.id %>)" class="btn-ghost" style="padding:5px 8px;color:#c00;border-color:transparent;" title="Delete">
                      <span class="ms" style="font-size:16px;">delete</span>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <!-- Premium Empty State -->
        <div style="padding:80px 40px;text-align:center;">
          <div style="width:48px;height:48px;border:1px solid var(--border);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <span class="ms" style="color:var(--text-faint);font-size:22px;">inbox</span>
          </div>
          <h3 style="font-size:16px;font-weight:700;color:var(--text);margin-bottom:8px;">
            <%= searchQuery ? 'No results found' : 'No inquiries yet' %>
          </h3>
          <p style="font-size:13px;color:var(--text-muted);max-width:340px;margin:0 auto 24px;line-height:1.6;">
            <% if (searchQuery) { %>
              No leads match "<%= searchQuery %>". Try a different search term or clear the filter.
            <% } else { %>
              Client project requests submitted through your website contact form will appear here automatically.
            <% } %>
          </p>
          <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
            <% if (searchQuery) { %>
              <a href="/admin" class="btn-primary">Clear Search</a>
            <% } %>
            <a href="/" target="_blank" class="btn-ghost">View Landing Page <span class="ms" style="font-size:15px;">open_in_new</span></a>
            <button onclick="window.location.reload()" class="btn-ghost"><span class="ms" style="font-size:15px;">refresh</span> Refresh</button>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Footer -->
    <div style="margin-top:24px;text-align:center;font-size:12px;color:var(--text-faint);">
      <%= siteConfig.name %> Admin Panel &copy; <%= new Date().getFullYear() %>
    </div>

  </div>
</div>

<!-- Toast Notification -->
<div class="toast" id="toast">
  <span class="ms" style="font-size:16px;" id="toast-icon">check</span>
  <span id="toast-msg">Status updated</span>
</div>

<script>
  // Mobile sidebar
  function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('overlay').classList.toggle('open');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('overlay').classList.remove('open');
  }

  // Show menu btn on mobile
  if (window.innerWidth <= 768) {
    document.getElementById('menu-btn').style.display = 'flex';
  }
  window.addEventListener('resize', () => {
    document.getElementById('menu-btn').style.display = window.innerWidth <= 768 ? 'flex' : 'none';
  });

  // Toast
  function showToast(msg, isError = false) {
    const toast = document.getElementById('toast');
    document.getElementById('toast-msg').textContent = msg;
    document.getElementById('toast-icon').textContent = isError ? 'error' : 'check_circle';
    toast.style.background = isError ? '#c00' : '#111';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 3000);
  }

  // Update status
  async function updateInquiryStatus(id, newStatus) {
    try {
      const response = await fetch(`/api/inquiries/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      const result = await response.json();
      if (response.ok && result.success) {
        showToast('Status updated to ' + newStatus);
      } else {
        showToast(result.message || 'Failed to update status.', true);
      }
    } catch (error) {
      showToast('Server error while updating status.', true);
    }
  }

  // Delete
  async function deleteInquiry(id) {
    if (!confirm('Delete this lead permanently?')) return;
    try {
      const response = await fetch(`/api/inquiries/${id}`, { method: 'DELETE' });
      const result = await response.json();
      if (response.ok && result.success) {
        window.location.reload();
      } else {
        showToast(result.message || 'Failed to delete.', true);
      }
    } catch (error) {
      showToast('Server error while deleting.', true);
    }
  }

  // Responsive stats grid
  const statsGrid = document.querySelector('.stats-grid');
  function adjustStatsGrid() {
    if (window.innerWidth < 900) {
      statsGrid.style.gridTemplateColumns = 'repeat(2,1fr)';
    } else {
      statsGrid.style.gridTemplateColumns = 'repeat(5,1fr)';
    }
  }
  adjustStatsGrid();
  window.addEventListener('resize', adjustStatsGrid);
</script>
</body>
</html>
