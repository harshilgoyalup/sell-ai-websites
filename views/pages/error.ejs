<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <title><%= message %> | <%= siteConfig.name %></title>
  <!-- Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <!-- Geist Font -->
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet"/>
  <style>
    body {
      font-family: 'Geist', sans-serif;
    }
  </style>
</head>
<body class="bg-surface-container-lowest text-on-surface antialiased flex flex-col min-h-screen justify-between">

  <!-- Header -->
  <%- include('../components/header') %>

  <!-- Main Error Content -->
  <main class="flex-1 flex flex-col justify-center px-lg md:px-xl max-w-container-max mx-auto py-xxl text-center">
    <div class="max-w-md mx-auto">
      <span class="text-secondary font-label-sm-caps text-label-sm-caps uppercase tracking-widest block mb-md">ERROR <%= status %></span>
      <h1 class="font-headline-xl-mobile text-headline-xl-mobile md:text-headline-lg font-bold text-primary mb-md tracking-tight leading-none">
        <%= message %>
      </h1>
      <p class="font-body-md text-body-md text-secondary mb-xl">
        <%= description %>
      </p>
      <a class="inline-flex items-center justify-center gap-sm bg-primary text-on-primary font-body-lg text-body-lg px-xl py-md hover:bg-secondary transition-colors" href="/">
        Go Back Home
        <span class="material-symbols-outlined">arrow_forward</span>
      </a>
    </div>
  </main>

  <!-- Footer -->
  <%- include('../components/footer') %>

</body>
</html>
