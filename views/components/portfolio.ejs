<section class="px-lg md:px-xl max-w-container-max mx-auto py-xxl border-b border-surface-container-high" id="work" aria-label="Featured Projects">
  <!-- Section Header -->
  <div class="mb-xl flex flex-col md:flex-row md:items-end justify-between gap-md border-b border-outline-variant pb-lg">
    <div>
      <span class="font-label-sm-caps text-xs text-secondary uppercase tracking-widest block mb-xs font-semibold">THINGS I'VE BUILT</span>
      <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg text-primary font-bold tracking-tight">
        AI, software & experiments that solve real problems.
      </h2>
    </div>
    <p class="font-body-md text-body-md text-secondary max-w-md">
      A selection of projects I've designed, built and shipped.
    </p>
  </div>

  <!-- Featured Projects Container -->
  <div class="flex flex-col gap-xl">
    
    <% if (portfolio && portfolio.length >= 4) { %>
      <% 
        const p1 = portfolio[0]; // JEEVANSETU AI (Hero Card)
        const p2 = portfolio[1]; // AchieveHub AI (Grid Item 1)
        const p3 = portfolio[2]; // Roast My Resume (Grid Item 2)
        const p4 = portfolio[3]; // Harshil's Portfolio (Wide Banner)
      %>

      <!-- 01 — JEEVANSETU AI (Dominant Featured Hero Card) -->
      <article class="group border border-outline-variant bg-surface-container-lowest hover:bg-surface hover:-translate-y-1 transition-all duration-300 overflow-hidden rounded-DEFAULT">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          
          <!-- Text & Specs (7 cols) -->
          <div class="lg:col-span-7 p-lg md:p-xl flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-outline-variant">
            <div>
              <!-- Header Row -->
              <div class="flex items-center justify-between mb-sm">
                <span class="font-headline-md text-2xl font-bold text-secondary/40 group-hover:text-primary transition-colors duration-300"><%= p1.number %></span>
                <span class="text-[11px] font-bold uppercase tracking-widest px-sm py-[2px] border border-outline-variant bg-surface-container-high text-primary">
                  FEATURED PROJECT
                </span>
              </div>

              <!-- Title & Subtitle -->
              <h3 class="font-headline-lg text-3xl font-extrabold text-primary tracking-tight mb-xs">
                <%= p1.title %>
              </h3>
              <p class="font-body-md text-body-md font-semibold text-secondary mb-md">
                <%= p1.subtitle %>
              </p>

              <!-- Description -->
              <p class="font-body-md text-body-md text-secondary mb-lg leading-relaxed">
                "<%= p1.description %>"
              </p>

              <!-- Highlights Bullet List -->
              <div class="mb-lg">
                <span class="font-label-sm-caps text-[11px] font-bold uppercase tracking-widest text-secondary block mb-xs">Key Highlights</span>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-xs text-xs text-primary font-medium">
                  <% p1.highlights.forEach(highlight => { %>
                    <li class="flex items-center gap-xs">
                      <span class="w-1.5 h-1.5 bg-primary inline-block rounded-full"></span>
                      <span><%= highlight %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>

              <!-- Tech Tags -->
              <div class="flex flex-wrap gap-xs mb-xl">
                <% p1.technologies.forEach(tech => { %>
                  <span class="text-[11px] px-sm py-[3px] bg-surface-container-high text-primary font-medium border border-outline-variant">
                    <%= tech %>
                  </span>
                <% }) %>
              </div>
            </div>

            <!-- CTA Buttons -->
            <div class="flex flex-wrap gap-md pt-md border-t border-outline-variant">
              <% if (p1.liveUrl) { %>
                <a href="<%= p1.liveUrl %>" target="_blank" rel="noopener noreferrer" 
                  class="inline-flex items-center gap-xs px-lg py-sm bg-primary text-on-primary font-body-md text-body-md font-bold hover:bg-secondary transition-all">
                  <%= p1.buttonText %>
                </a>
              <% } %>
              <% if (p1.githubUrl) { %>
                <a href="<%= p1.githubUrl %>" target="_blank" rel="noopener noreferrer" 
                  class="inline-flex items-center gap-xs px-lg py-sm border border-outline-variant text-secondary hover:text-primary hover:border-primary font-body-md text-body-md transition-all">
                  <%= p1.secondaryButtonText %>
                </a>
              <% } %>
            </div>
          </div>

          <!-- Custom UI Preview Mockup (5 cols) -->
          <div class="lg:col-span-5 bg-surface-container p-md md:p-lg flex items-center justify-center overflow-hidden">
            <div class="w-full max-w-md bg-primary text-on-primary p-md border border-outline-variant rounded-DEFAULT shadow-xl group-hover:scale-[1.02] transition-transform duration-500">
              
              <!-- Mockup Browser Bar -->
              <div class="flex items-center justify-between border-b border-surface-container-high pb-xs mb-md">
                <div class="flex gap-xs">
                  <span class="w-2.5 h-2.5 rounded-full bg-surface-container-high inline-block"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-surface-container-high inline-block"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-surface-container-high inline-block"></span>
                </div>
                <span class="text-[10px] font-mono text-secondary">jeevansetu-ai.app</span>
                <span class="text-[9px] px-xs py-[1px] bg-red-950 text-red-400 font-mono font-bold uppercase border border-red-800">LIVE MONITOR</span>
              </div>

              <!-- Telemetry Header -->
              <div class="grid grid-cols-2 gap-xs mb-md text-[11px] font-mono">
                <div class="bg-surface-container-high p-xs border border-outline-variant">
                  <span class="text-secondary block text-[9px]">FLOOD RISK INDEX</span>
                  <span class="font-bold text-white text-sm">HIGH (84/100)</span>
                </div>
                <div class="bg-surface-container-high p-xs border border-outline-variant">
                  <span class="text-secondary block text-[9px]">OPEN-METEO DATA</span>
                  <span class="font-bold text-white text-sm">112 mm/h</span>
                </div>
              </div>

              <!-- Map Simulation Grid -->
              <div class="border border-outline-variant bg-black p-sm mb-md relative overflow-hidden h-32 flex flex-col justify-between">
                <!-- Background Grid Lines -->
                <div class="absolute inset-0 opacity-20 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:16px_16px]"></div>
                
                <div class="relative z-10 flex justify-between items-start">
                  <span class="text-[9px] font-mono bg-white/10 px-xs py-[2px] text-white">INTERACTIVE RADAR</span>
                  <span class="text-[9px] font-mono text-red-400 animate-pulse">● ZONE-4 ELEVATION ALERT</span>
                </div>

                <!-- Emergency Node -->
                <div class="relative z-10 bg-white/10 border border-white/20 p-xs text-[10px] font-mono text-white max-w-[200px]">
                  <span class="block font-bold">Rescuer Alert Broadcast</span>
                  <span class="text-[9px] text-secondary">Coordinates: 26.8467° N, 80.9462° E</span>
                </div>
              </div>

              <!-- Gemini Reasoning Snippet -->
              <div class="p-xs bg-surface-container-high border-l-2 border-white text-[11px] font-mono">
                <span class="text-secondary block text-[9px]">GEMINI INTEL REASONING</span>
                <span class="text-white">"Hydro-model detects 3.2m surge probability. Actionable alert dispatched."</span>
              </div>
            </div>
          </div>

        </div>
      </article>


      <!-- 02 & 03 Grid Section -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-xl">
        
        <!-- 02 — AchieveHub AI -->
        <article class="group border border-outline-variant bg-surface-container-lowest hover:bg-surface hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden rounded-DEFAULT">
          <div class="p-lg md:p-xl">
            <!-- Header Row -->
            <div class="flex items-center justify-between mb-sm">
              <span class="font-headline-md text-2xl font-bold text-secondary/40 group-hover:text-primary transition-colors duration-300"><%= p2.number %></span>
              <span class="text-[10px] font-bold uppercase tracking-widest px-sm py-[2px] border border-outline-variant bg-surface-container-high text-primary">
                STUDENT AI
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-headline-md text-2xl font-extrabold text-primary tracking-tight mb-xs">
              <%= p2.title %>
            </h3>
            <p class="font-body-md text-sm font-semibold text-secondary mb-md">
              <%= p2.subtitle %>
            </p>

            <!-- Description -->
            <p class="font-body-md text-sm text-secondary mb-md leading-relaxed">
              "<%= p2.description %>"
            </p>

            <!-- UI Preview Mockup (AchieveHub AI) -->
            <div class="my-md bg-surface-container p-sm border border-outline-variant overflow-hidden">
              <div class="bg-primary text-on-primary p-xs border border-outline-variant group-hover:scale-[1.02] transition-transform duration-500">
                <div class="flex justify-between items-center border-b border-surface-container-high pb-xs mb-xs text-[10px] font-mono">
                  <span class="text-secondary">AchieveHub Dashboard</span>
                  <span class="text-white font-bold">Rank #1 Student</span>
                </div>
                <div class="grid grid-cols-2 gap-xs text-[10px] font-mono mb-xs">
                  <div class="bg-surface-container-high p-xs">
                    <span class="text-secondary block text-[8px]">CERTIFICATES</span>
                    <span class="text-white font-bold">14 Verified</span>
                  </div>
                  <div class="bg-surface-container-high p-xs">
                    <span class="text-secondary block text-[8px]">AI INSIGHT</span>
                    <span class="text-white font-bold">Top 2% Velocity</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Highlights Bullet List -->
            <div class="mb-md">
              <ul class="grid grid-cols-1 gap-xs text-xs text-primary font-medium">
                <% p2.highlights.forEach(highlight => { %>
                  <li class="flex items-center gap-xs">
                    <span class="w-1.5 h-1.5 bg-primary inline-block rounded-full"></span>
                    <span><%= highlight %></span>
                  </li>
                <% }) %>
              </ul>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-xs mb-md">
              <% p2.technologies.forEach(tech => { %>
                <span class="text-[10px] px-sm py-[2px] bg-surface-container-high text-primary font-medium border border-outline-variant">
                  <%= tech %>
                </span>
              <% }) %>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="p-lg md:px-xl md:pb-xl pt-0 border-t border-outline-variant">
            <% if (p2.liveUrl) { %>
              <a href="<%= p2.liveUrl %>" target="_blank" rel="noopener noreferrer" 
                class="w-full inline-flex items-center justify-center gap-xs px-md py-sm bg-primary text-on-primary font-body-md text-sm font-bold hover:bg-secondary transition-all">
                <%= p2.buttonText %>
              </a>
            <% } %>
          </div>
        </article>


        <!-- 03 — Roast My Resume -->
        <article class="group border border-outline-variant bg-surface-container-lowest hover:bg-surface hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden rounded-DEFAULT">
          <div class="p-lg md:p-xl">
            <!-- Header Row -->
            <div class="flex items-center justify-between mb-sm">
              <span class="font-headline-md text-2xl font-bold text-secondary/40 group-hover:text-primary transition-colors duration-300"><%= p3.number %></span>
              <span class="text-[10px] font-bold uppercase tracking-widest px-sm py-[2px] border border-outline-variant bg-surface-container-high text-primary">
                RESUME AI
              </span>
            </div>

            <!-- Title & Subtitle -->
            <h3 class="font-headline-md text-2xl font-extrabold text-primary tracking-tight mb-xs">
              <%= p3.title %>
            </h3>
            <p class="font-body-md text-sm font-semibold text-secondary mb-md">
              <%= p3.subtitle %>
            </p>

            <!-- Description -->
            <p class="font-body-md text-sm text-secondary mb-md leading-relaxed">
              "<%= p3.description %>"
            </p>

            <!-- UI Preview Mockup (Roast My Resume) -->
            <div class="my-md bg-surface-container p-sm border border-outline-variant overflow-hidden">
              <div class="bg-primary text-on-primary p-xs border border-outline-variant group-hover:scale-[1.02] transition-transform duration-500">
                <div class="flex justify-between items-center border-b border-surface-container-high pb-xs mb-xs text-[10px] font-mono">
                  <span class="text-secondary">AI Resume Review</span>
                  <span class="text-white font-bold">Score: 84 / 100</span>
                </div>
                <div class="bg-surface-container-high p-xs text-[10px] font-mono border-l-2 border-white">
                  <span class="text-secondary block text-[8px]">BRUTAL AI CRITIC</span>
                  <span class="text-white">"Remove generic buzzwords & quantify metric impact."</span>
                </div>
              </div>
            </div>

            <!-- Highlights Bullet List -->
            <div class="mb-md">
              <ul class="grid grid-cols-1 gap-xs text-xs text-primary font-medium">
                <% p3.highlights.forEach(highlight => { %>
                  <li class="flex items-center gap-xs">
                    <span class="w-1.5 h-1.5 bg-primary inline-block rounded-full"></span>
                    <span><%= highlight %></span>
                  </li>
                <% }) %>
              </ul>
            </div>

            <!-- Tech Tags -->
            <div class="flex flex-wrap gap-xs mb-md">
              <% p3.technologies.forEach(tech => { %>
                <span class="text-[10px] px-sm py-[2px] bg-surface-container-high text-primary font-medium border border-outline-variant">
                  <%= tech %>
                </span>
              <% }) %>
            </div>
          </div>

          <!-- CTA Button -->
          <div class="p-lg md:px-xl md:pb-xl pt-0 border-t border-outline-variant">
            <% if (p3.liveUrl) { %>
              <a href="<%= p3.liveUrl %>" target="_blank" rel="noopener noreferrer" 
                class="w-full inline-flex items-center justify-center gap-xs px-md py-sm bg-primary text-on-primary font-body-md text-sm font-bold hover:bg-secondary transition-all">
                <%= p3.buttonText %>
              </a>
            <% } %>
          </div>
        </article>

      </div>


      <!-- 04 — Harshil's Portfolio (Wide Horizontal Banner Card) -->
      <article class="group border border-outline-variant bg-surface-container-lowest hover:bg-surface hover:-translate-y-1 transition-all duration-300 overflow-hidden rounded-DEFAULT">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          
          <!-- Text Details (8 cols) -->
          <div class="lg:col-span-8 p-lg md:p-xl flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-outline-variant">
            <div>
              <div class="flex items-center justify-between mb-sm">
                <span class="font-headline-md text-2xl font-bold text-secondary/40 group-hover:text-primary transition-colors duration-300"><%= p4.number %></span>
                <span class="text-[10px] font-bold uppercase tracking-widest px-sm py-[2px] border border-outline-variant bg-surface-container-high text-primary">
                  DEVELOPER PORTFOLIO
                </span>
              </div>

              <h3 class="font-headline-lg text-2xl font-extrabold text-primary tracking-tight mb-xs">
                <%= p4.title %>
              </h3>
              <p class="font-body-md text-sm font-semibold text-secondary mb-md">
                <%= p4.subtitle %>
              </p>

              <p class="font-body-md text-sm text-secondary mb-md leading-relaxed">
                "<%= p4.description %>"
              </p>

              <!-- Highlights -->
              <div class="mb-md">
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-xs text-xs text-primary font-medium">
                  <% p4.highlights.forEach(highlight => { %>
                    <li class="flex items-center gap-xs">
                      <span class="w-1.5 h-1.5 bg-primary inline-block rounded-full"></span>
                      <span><%= highlight %></span>
                    </li>
                  <% }) %>
                </ul>
              </div>

              <!-- Tech Tags -->
              <div class="flex flex-wrap gap-xs mb-md">
                <% p4.technologies.forEach(tech => { %>
                  <span class="text-[10px] px-sm py-[2px] bg-surface-container-high text-primary font-medium border border-outline-variant">
                    <%= tech %>
                  </span>
                <% }) %>
              </div>
            </div>

            <!-- CTA Button -->
            <div class="pt-md border-t border-outline-variant">
              <% if (p4.liveUrl) { %>
                <a href="<%= p4.liveUrl %>" target="_blank" rel="noopener noreferrer" 
                  class="inline-flex items-center gap-xs px-lg py-sm bg-primary text-on-primary font-body-md text-sm font-bold hover:bg-secondary transition-all">
                  <%= p4.buttonText %>
                </a>
              <% } %>
            </div>
          </div>

          <!-- Code / Visual Mockup (4 cols) -->
          <div class="lg:col-span-4 bg-surface-container p-md flex items-center justify-center overflow-hidden">
            <div class="w-full bg-primary text-on-primary p-xs border border-outline-variant group-hover:scale-[1.02] transition-transform duration-500 font-mono text-[10px]">
              <div class="flex items-center justify-between border-b border-surface-container-high pb-xs mb-xs">
                <span class="text-secondary">harshil.config.js</span>
                <span class="text-white font-bold">PORTFOLIO v2</span>
              </div>
              <div class="space-y-xs text-secondary">
                <div><span class="text-white font-bold">const</span> developer = {</div>
                <div class="pl-md">name: <span class="text-white">'Harshil Goyal'</span>,</div>
                <div class="pl-md">focus: <span class="text-white">'AI Products & Software'</span>,</div>
                <div class="pl-md">status: <span class="text-white">'Building & Shipping'</span></div>
                <div>};</div>
              </div>
            </div>
          </div>

        </div>
      </article>

    <% } %>

  </div>
</section>

<!-- Motion preference styling -->
<style>
  @media (prefers-reduced-motion: reduce) {
    .group-hover\:scale-\[1\.02\],
    .group-hover\:-translate-y-1 {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
